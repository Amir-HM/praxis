# Rättskoll OCR Test - Environment Variables
# ============================================

# Replicate API Token (for DeepSeek-OCR)
# Get yours at: https://replicate.com/account
REPLICATE_API_TOKEN=r8_your_token_here

# Google API Key (for Gemini OCR)
# Get yours at: https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_google_api_key_here

# OpenRouter API Key (for Claude extraction via OpenRouter)
# Get yours at: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Note: Copy this file to .env and replace with your actual tokens
# The .env file is gitignored and should never be committed
